	chapter.1B45D2CCDCFEECA9.title: "Небо и оружие"
	chapter.386F374098E4F64C.title: "Create и механика"
	chapter.4A3805A1255418C0.title: "Союз колоний"
	chapter.511CDD202EEDCF73.title: "Акт III. Изгнанники короны"
	chapter.56DA8F1FC6CEDD4F.title: "Акт IV. Пробуждение Древних"
	chapter.5D36E99F22266A0B.title: "Начало пути"
	chapter.6BBBFACE0982DDB2.title: "Акт I. Новая земля"
	chapter.6C116A6EE050C76F.title: "Акт V. Последняя запись"
	chapter.7C345148ECC0E727.title: "Приключения"
	chapter_group.39116B943AB5A383.title: "Сюжет: Пепел Вальдгарда"
	chapter_group.7EF632FF72129737.title: "Путеводитель"
	quest.003E7F2BEE31F210.quest_desc: ["Без строителя ратуша останется пустой площадью. Постройте &eхижину строителя&r."]
	quest.003E7F2BEE31F210.title: "Руки поселения"
	quest.0078FFFD3DBDFA71.quest_desc: ["Победите &6Незеритовое чудовище&r."]
	quest.0078FFFD3DBDFA71.title: "Незеритовое чудовище"
	quest.034954F06284F64C.quest_desc: ["В тайнике среди награбленного лежала вторая тетрадь Элиаса, перевязанная картографическим шнуром."
		""
		"&e&oДень 41.&r&o Я понял, кто такие «серые плащи». Это Королевская стража Вальдгарда. В ночь пепла король Альдрик Третий открыл &cпять печатей&o, за которыми его предки держали &cДревних&o: стражей, созданных задолго до людей. Он хотел, чтобы они служили ему.&r"
		""
		"&e&oДень 42.&r&o Стража поняла, что происходит, и подняла мятеж. Они убили короля, но печати уже были сломаны. Древние проснулись, а стражу прокляли как цареубийц. Их потомки до сих пор считают эту землю своей и ненавидят любой новый город.&r"
		"&o— Э. В.&r"]
	quest.034954F06284F64C.title: "Дневник, страница вторая"
	quest.0438E24DF914A0A1.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.0438E24DF914A0A1.title: "Последний удар"
	quest.0678A68B64EB86F1.quest_desc: ["&oОтец писал про склепы у дороги. Я нашла в архивах Ордена его старую опись снаряжения: кирки, верёвки, двадцать фунтов пороха. Зачем картографам порох?&r"
		"&d— Мира Ворн&r"]
	quest.0678A68B64EB86F1.title: "Северная дорога"
	quest.06A55B7DC6E984D2.quest_desc: ["Изгнанники прячут добычу в лесных укрытиях. Разграбьте &cтайник иллагеров&r. Если повезёт, там окажутся вещи экспедиции."
		""
		"&7Подсказка: небольшие лагеря иллагеров в лесах (Dungeons and Taverns)."]
	quest.06A55B7DC6E984D2.title: "Тайник изгнанников"
	quest.06DA42A52AD5B69E.quest_desc: ["&7Необязательно.&r Отец упоминал тюрьму во льдах, куда король ссылал предателей. Найдите &bЛедяную темницу&r."]
	quest.06DA42A52AD5B69E.title: "Ледяная темница"
	quest.086A097C050F8E1E.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.086A097C050F8E1E.title: "Был в этом бою"
	quest.0977EBDE091192C0.quest_desc: ["Трактирщик долго молчал, а потом вынес вам обгоревшую тетрадь. «Картограф оставил. Сказал, придут за ней»."
		""
		"&e&oДень 12.&r&o Вальдгард не был разрушен войной. Ни следов осады, ни пожарищ. Люди просто ушли из домов, оставив хлеб на столах. В деревнях говорят о «ночи пепла», но никто не знает, что сгорело.&r"
		""
		"&e&oДень 19.&r&o Нашли старые склепы вдоль северной дороги. Там пусто, но на стенах — королевский герб и одно слово, выцарапанное много раз: «ПЕЧАТИ».&r"
		"&o— Э. В.&r"]
	quest.0977EBDE091192C0.title: "Дневник, страница первая"
	quest.09F030E8796D8D6F.quest_desc: ["Делает инструменты и броню для жителей."]
	quest.09F030E8796D8D6F.title: "Кузнец"
	quest.0BFCA79DC95C8898.quest_desc: ["Повар кормит колонию готовой едой."]
	quest.0BFCA79DC95C8898.title: "Повар"
	quest.0C9CD80B2C97BFA5.quest_desc: ["Кровать задаёт точку возрождения. &7/home тут нет, зато есть /back и /tpa."]
	quest.0C9CD80B2C97BFA5.title: "Спокойной ночи"
	quest.0DE4EDB063BA6C0E.quest_desc: ["Поставьте &eратушу&r колонии. Здесь начнётся новая история этих земель."
		""
		"&oОтец всегда говорил: «Карта без города, всего лишь рисунок. Город без карты, всего лишь стены».&r"
		""
		"&7Подсказка: ратушу ставят золотым скипетром из лагеря снабжения."]
	quest.0DE4EDB063BA6C0E.title: "Первый камень"
	quest.10E373A76ADC389A.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.10E373A76ADC389A.title: "Был в этом бою"
	quest.112634FF50AD96E1.quest_desc: ["Войдите в &5Край&r."]
	quest.112634FF50AD96E1.title: "За краем"
	quest.119AB38AC3A24536.quest_desc: ["Больше домов, больше жителей."]
	quest.119AB38AC3A24536.title: "Жильё"
	quest.1282D31284BDFAC3.quest_desc: ["Вырастите колонию до &e25&r жителей. Изгнанники нападают на слабых, а большой город они будут обходить стороной."]
	quest.1282D31284BDFAC3.title: "Город, а не лагерь"
	quest.12E033A9C25316A9.quest_desc: ["Строитель возводит всё остальное. Носи ему ресурсы, которые он просит."]
	quest.12E033A9C25316A9.title: "Хижина строителя"
	quest.131AFC3C8A11DDEC.quest_desc: ["Ещё еда и иногда сокровища."]
	quest.131AFC3C8A11DDEC.title: "Рыбак"
	quest.145D52871F371E21.quest_desc: ["Таверна привлекает &eпосетителей&r. Их можно нанять: бывают редкие специалисты."]
	quest.145D52871F371E21.title: "Таверна"
	quest.14919EC0EF8899ED.quest_desc: ["&oЕсли вы читаете это, значит, корабль всё-таки дошёл.&r"
		""
		"Сто лет назад на этих берегах стояло королевство &6Вальдгард&r. Однажды оно исчезло за одну ночь: города опустели, дороги заросли, а в старых крепостях поселились люди в серых плащах, которые больше не помнят своих имён."
		""
		"Десять лет назад сюда ушла экспедиция Ордена Картографов во главе с моим отцом, магистром &eЭлиасом Ворном&r. Назад не вернулся никто. Последнее письмо отца было коротким: &o«Не ищите меня. Стройте. Им нужен город, а не я».&r"
		""
		"Я не знаю, что это значит. Но я знаю, что одна я ответа не найду. Основайте поселение, а я буду писать вам всё, что узнаю."
		""
		"&d— Мира Ворн&r"]
	quest.14919EC0EF8899ED.title: "Письмо Миры"
	quest.154814510D9604AE.quest_desc: ["&bFarmer's Delight&r: готовь сытную еду. Колонистам тоже нравится."]
	quest.154814510D9604AE.title: "Кастрюля"
	quest.157AC6E5B4689123.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.157AC6E5B4689123.title: "Был в этом бою"
	quest.16A54AB8ED64039B.quest_desc: ["Командир успел бежать в старый лесной &cособняк&r. Найдите его и победите &cзаклинателя&r, который им правит."
		""
		"&7Подсказка: особняк стоит в тёмном лесу, карту к нему продают картографы деревень."]
	quest.16A54AB8ED64039B.title: "Особняк узурпатора"
	quest.17B1827491F56003.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.17B1827491F56003.title: "Последний удар"
	quest.19A061917D996E72.quest_desc: ["Найдите &bалмазы&r. Теперь понятно, зачем экспедиции порох: они искали путь вниз, глубже обычных шахт."
		""
		"&oВ описи есть ещё строчка: «Глубиномер — 2 шт.». Отец измерял, насколько глубоко уходят королевские туннели.&r"
		"&d— Мира Ворн&r"]
	quest.19A061917D996E72.title: "Порох и алмазы"
	quest.1A5895413D99199A.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.1A5895413D99199A.title: "Последний удар"
	quest.1B3ACC3C2FD1E837.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.1B3ACC3C2FD1E837.title: "Был в этом бою"
	quest.1C93CD0C79952EE7.quest_desc: ["Колонию начинают с &eлагеря снабжения&r (на суше) или &eкорабля&r (на воде)."
		"Поставь его там, где будет город: внутри сундук со стартовыми вещами."]
	quest.1C93CD0C79952EE7.title: "Лагерь снабжения"
	quest.1D8580E886BFC778.quest_desc: ["После смерти вещи остаются в &bмогиле&r. Приходи и забирай."
		"Записка о смерти подскажет координаты."]
	quest.1D8580E886BFC778.title: "Если умер"
	quest.1F6B560AA3643289.quest_desc: ["Найдите &cкрепость иллагеров&r: каменную твердыню, где засел их командир."
		""
		"&7Подсказка: When Dungeons Arise, большие крепости на равнинах и в лесах."]
	quest.1F6B560AA3643289.title: "Крепость изгнанников"
	quest.201DC9DFA137709D.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.201DC9DFA137709D.title: "Был в этом бою"
	quest.217167A67E523C62.quest_desc: ["Отряды разбойников рядом с колонией запускают рейд. Держите стражу наготове и помогайте друг другу."]
	quest.217167A67E523C62.title: "Разбойники"
	quest.224180DCC6C8B07D.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.224180DCC6C8B07D.title: "Последний удар"
	quest.227303E287B8D17B.quest_desc: ["&bXaero's Minimap&r: клавиша &eB&r ставит метку, &eM&r открывает карту мира."
		"Отметь место для своей колонии."]
	quest.227303E287B8D17B.title: "Карта и метки"
	quest.2576DE44722CFB55.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.2576DE44722CFB55.title: "Был в этом бою"
	quest.2626A1AC7014C12D.quest_desc: ["&aАкт IV завершён.&r Откройте &eАкт V. Последняя запись&r."]
	quest.2626A1AC7014C12D.title: "За краем мира"
	quest.26A5CC47A995FD6F.quest_desc: ["Для самолётов и быстрых судов."]
	quest.26A5CC47A995FD6F.title: "Пропеллер"
	quest.26BF9E72CF451681.quest_desc: ["Найдите &6Пылающую арену&r в Незере."]
	quest.26BF9E72CF451681.title: "Печать Пламени"
	quest.27179B05C32A33D5.quest_desc: ["Исследования открывают новые здания и бонусы."]
	quest.27179B05C32A33D5.title: "Университет"
	quest.272B8F5AA32A61B1.quest_desc: ["Найдите &5Разрушенную цитадель&r на дальних островах Края."
		""
		"&oУ ворот лежит палатка картографа. Внутри аккуратно сложены инструменты и одна тетрадь.&r"]
	quest.272B8F5AA32A61B1.title: "Разрушенная цитадель"
	quest.2862BD966B72D0E0.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.2862BD966B72D0E0.title: "Последний удар"
	quest.2A0481089BD42DFC.quest_desc: ["База всего &eCreate&r. Ищи рецепты в JEI, в Create ещё есть понятные &eпонд-сцены&r (держи W над предметом)."]
	quest.2A0481089BD42DFC.title: "Андезитовый сплав"
	quest.2AC3EE0DD3910B4F.quest_desc: ["Разберись с местной нежитью."]
	quest.2AC3EE0DD3910B4F.title: "Первая кровь"
	quest.2BB33E7CCC18F395.quest_desc: ["Постройте &eсторожевую башню&r."]
	quest.2BB33E7CCC18F395.title: "Стены и дозор"
	quest.2C532E9A1F38B35E.quest_desc: ["Победите &5Стража Края&r, последнего из Древних."]
	quest.2C532E9A1F38B35E.title: "Пятый страж"
	quest.2D4B75E1F7EEBE26.quest_desc: ["Победите &6Игниса&r, Пламя Вальдгарда."
		""
		"&7Подсказка: запаситесь зельями огнестойкости и щитом."]
	quest.2D4B75E1F7EEBE26.title: "Игнис"
	quest.2EA1093AD2B14601.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.2EA1093AD2B14601.title: "Последний удар"
	quest.2EC98FBF504C05A1.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.2EC98FBF504C05A1.title: "Последний удар"
	quest.2FB8790FDCBD98CD.quest_desc: ["Артефакты лежат в сундуках данжей. Но иногда сундук оказывается &cмимиком&r."
		"Победи мимика, у него тоже бывают артефакты."]
	quest.2FB8790FDCBD98CD.title: "Мимик"
	quest.300AB4E90349B286.quest_desc: ["&7Необязательно.&r Победите &3Сциллу&r."]
	quest.300AB4E90349B286.title: "Сцилла"
	quest.318CD2A505CAFCCB.quest_desc: ["Книгу-гайд выдают при первом входе. В ней налоги, фракции, шпионы и войны."
		"Налоги каждое здание платит само. Забирай их через книгу налогов, валюта: &aизумруды&r."]
	quest.318CD2A505CAFCCB.title: "Кодекс War 'N Taxes"
	quest.32777806105AF476.quest_desc: ["Открывает продвинутую логистику Create."]
	quest.32777806105AF476.title: "Латунь"
	quest.327D3ECC3D507730.quest_desc: ["&7Необязательно.&r В пустынях стоит пирамида старше Вальдгарда. Найдите её."]
	quest.327D3ECC3D507730.title: "Проклятая пирамида"
	quest.363A071872165639.quest_desc: ["Найдите &6Древнюю фабрику&r: подземный завод, которому тысячи лет."]
	quest.363A071872165639.title: "Машина под землёй"
	quest.371BD318EDEAB94B.quest_desc: ["Теперь вы знаете, что случилось с Вальдгардом. Но изгнанники не дадут колонии жить спокойно."
		""
		"&aАкт II завершён.&r Откройте &eАкт III. Изгнанники короны&r."]
	quest.371BD318EDEAB94B.title: "Имя короля"
	quest.37583A6ACA21F59E.quest_desc: ["Для шахт, карьеров и раскопок жил."]
	quest.37583A6ACA21F59E.title: "Бур"
	quest.379CC4B82F1E0797.quest_desc: ["&bCreate Aeronautics&r: оболочка, горелка, и конструкция взлетает."
		"Собирай дирижабли, самолёты и машины."]
	quest.379CC4B82F1E0797.title: "Воздушный шар"
	quest.38D682674BE4BE01.quest_desc: ["Железо нужно почти везде: в Create, в колонии, в оружии."]
	quest.38D682674BE4BE01.title: "Железо"
	quest.3924193867170B31.quest_desc: ["Копает ресурсы для колонии. Ставь хижину над будущей шахтой."]
	quest.3924193867170B31.title: "Шахтёр"
	quest.39A96316068716BF.quest_desc: ["Пластины, сжатие, автоматизация."]
	quest.39A96316068716BF.title: "Механический пресс"
	quest.3A68658248A62C2D.quest_desc: ["&7Необязательно.&r Найдите затопленный &3Акрополь&r."]
	quest.3A68658248A62C2D.title: "Акрополь"
	quest.3B5AEDA55E704283.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.3B5AEDA55E704283.title: "Был в этом бою"
	quest.3D7512F73F8F0E0D.quest_desc: ["Найдите &6Кузницу душ&r в Незере, где спит второй страж."]
	quest.3D7512F73F8F0E0D.title: "Кузня душ"
	quest.3F096CF6EB4E375B.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.3F096CF6EB4E375B.title: "Был в этом бою"
	quest.4138C92F8E540A7F.quest_desc: ["&eЗолотой скипетр&r (Structurize) выбирает стиль и показывает, где встанет здание."
		"Именно им ставятся все хижины."]
	quest.4138C92F8E540A7F.title: "Инструмент строителя"
	quest.41E4F2ED8F89697F.quest_desc: ["Это сборка про &bколонии&r, &eCreate&r и приключения."
		""
		"Квесты подскажут, с чего начать. Награды скромные: это гид, а не магазин."
		""
		"&7Рецепты смотри в JEI (справа в инвентаре). Наведись на блок, и Jade покажет, что это."]
	quest.41E4F2ED8F89697F.title: "&6Добро пожаловать!"
	quest.41FB9A4A36360EC0.quest_desc: ["&oК нам пришли беженцы с юга. Их деревню сожгли люди в серых плащах. Они сказали, что следующим будет наш город: изгнанники не терпят тех, кто строит на «их» земле.&r"
		""
		"&oГотовьтесь. Я буду искать в записях отца, как с ними говорить. Или как их остановить.&r"
		"&d— Мира Ворн&r"]
	quest.41FB9A4A36360EC0.title: "Они идут"
	quest.429D234BDB65B72F.quest_desc: ["Еда для колонии. Голодные жители работают хуже."]
	quest.429D234BDB65B72F.title: "Фермер"
	quest.453BFE5C4F58F3CE.quest_desc: ["&oЯ сверила записи отца с картами Ордена. Четыре печати из пяти можно найти: две в Незере, одна под землёй, одна в океане. Пятая… отец пишет «за краем». Об этом потом.&r"
		""
		"&oЭто самые опасные места этих земель. Идите вместе и готовьтесь как следует.&r"
		"&d— Мира Ворн&r"]
	quest.453BFE5C4F58F3CE.title: "Четыре стража"
	quest.45BC9BA0353614A5.quest_desc: ["Портал и вперёд."]
	quest.45BC9BA0353614A5.title: "Незер"
	quest.461CE977690383A8.quest_desc: ["Без кирки далеко не уйдёшь."]
	quest.461CE977690383A8.title: "Каменная кирка"
	quest.46AA5F8E6C7664F7.quest_desc: ["Гора незерита, которая очень зла."]
	quest.46AA5F8E6C7664F7.title: "Незеритовое чудовище"
	quest.46C5AE843A765A83.quest_desc: ["&bCreate Big Cannons&r: лафет, ствол, заряды. Пираты будут в восторге."]
	quest.46C5AE843A765A83.title: "Пушка"
	quest.476720ACFF28139D.quest_desc: ["Победите &6Предвестника&r. Пушки и огнестрел сейчас очень пригодятся."]
	quest.476720ACFF28139D.title: "Предвестник"
	quest.47FEFDF2B8B8E560.quest_desc: ["Отразите полноценный &cнабег&r на деревню."
		""
		"&oПосле боя среди павших нашли старика с королевским перстнем. Он сказал одно: «Крепость. Там командир. Он помнит короля».&r"
		"&d— Мира Ворн&r"]
	quest.47FEFDF2B8B8E560.title: "Набег отбит"
	quest.496D7F55A00B7719.quest_desc: ["Победите &5Эндер-дракона&r. Он стережёт путь к цитадели, но он — не пятый страж."]
	quest.496D7F55A00B7719.title: "Сторож порога"
	quest.4A98BBC93D5823A6.quest_desc: ["Шесть патронов, никаких вопросов."]
	quest.4A98BBC93D5823A6.title: "Револьвер"
	quest.4B12B5DFB51F55BF.quest_desc: ["Спальник из &bComforts&r: можно поспать в походе и не сбить точку возрождения."]
	quest.4B12B5DFB51F55BF.title: "Спальник"
	quest.4CA0E8A286ABE5E6.quest_desc: ["Сразите &cкапитана&r изгнанников. Это тот, кто носит зловещее знамя."]
	quest.4CA0E8A286ABE5E6.title: "Сорванное знамя"
	quest.4D0B5F60919F1219.quest_desc: ["Разведчики заметили башню с флагом. Найдите &cаванпост разбойников&r."
		""
		"&oОни носят серые плащи, но под ними — старые доспехи с гербом Вальдгарда. Это не бандиты. Это бывшая королевская стража.&r"
		"&d— Мира Ворн&r"]
	quest.4D0B5F60919F1219.title: "Чужой флаг"
	quest.4E1488CB8A688D58.quest_desc: ["Торговые пути между союзными колониями дают пассивный доход за расстояние."
		"Чем дальше колонии друг от друга, тем выгоднее, а ещё повод проложить дорогу."]
	quest.4E1488CB8A688D58.title: "Торговый путь"
	quest.4F071683A9847E14.quest_desc: ["&7Эпилог.&r Улучшите ратушу до &e5 уровня&r. Пусть у этой земли снова будет столица."]
	quest.4F071683A9847E14.title: "Новый Вальдгард"
	quest.4F18FDCA0A7E2654.quest_desc: ["Тот самый."]
	quest.4F18FDCA0A7E2654.title: "Дробовик"
	quest.4F628D684638EBD6.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.4F628D684638EBD6.title: "Был в этом бою"
	quest.4FC5711561F6A307.quest_desc: ["Теперь ясно, что значили слова Элиаса. Чтобы земля успокоилась, нужно закончить то, что начал король: победить Древних стражей."
		""
		"&aАкт III завершён.&r Откройте &eАкт IV. Пробуждение Древних&r."]
	quest.4FC5711561F6A307.title: "Пять печатей"
	quest.512BED9634E91F3D.quest_desc: ["&7Необязательно.&r Победите &bМаледиктуса&r, проклятого тюремщика."]
	quest.512BED9634E91F3D.title: "Маледиктус"
	quest.539CEAF1D75D5583.quest_desc: ["Последнее письмо отца пришло из придорожной таверны. Таких в этих землях много: они стоят у дорог, в лесах и пустынях. Найдите любую."
		""
		"&7Подсказка: таверны генерирует Dungeons and Taverns, ищите крупные деревянные здания у дорог и деревень."]
	quest.539CEAF1D75D5583.title: "Таверна на краю карты"
	quest.552D918C2B44EED7.quest_desc: ["Постройте портал и войдите в &cНезер&r."]
	quest.552D918C2B44EED7.title: "Врата в пекло"
	quest.55FC6B151BD0AFFB.quest_desc: ["Время навестить дракона."]
	quest.55FC6B151BD0AFFB.title: "Край"
	quest.572DBD3EA9F7E03C.quest_desc: ["Классика. Наруби брёвен и сделай верстак."]
	quest.572DBD3EA9F7E03C.title: "Верстак"
	quest.57EB35500A50BD82.quest_desc: ["Много мощности для серьёзных заводов."]
	quest.57EB35500A50BD82.title: "Паровой двигатель"
	quest.583822B286EBAD32.quest_desc: ["&bCreate: Gunsmithing&r: стимпанк-оружие на механизмах Create."
		"Начни с кремнёвки. Крипер с дробовика будет потом."]
	quest.583822B286EBAD32.title: "Первый ствол"
	quest.586C928D4F4B155B.quest_desc: ["&bCreate: MineColonies Link&r связывает запросы колонии с логистикой Create."
		"Склад колонии может получать вещи с вашего завода."]
	quest.586C928D4F4B155B.title: "Create + колония"
	quest.5950635EFD99990E.quest_desc: ["Победите &6Левиафана&r."
		""
		"&7Подсказка: зелья подводного дыхания, черепашьи шлемы, трезубцы."]
	quest.5950635EFD99990E.title: "Левиафан"
	quest.5B4EF1D088769941.quest_desc: ["Найдите &6Затонувший город&r на дне океана."]
	quest.5B4EF1D088769941.title: "Бездна под морем"
	quest.5C0D0D4DEBC97B54.quest_desc: ["После четвёртого стража командир изгнанников сам пришёл к воротам колонии. Без оружия. Он протянул последнюю тетрадь."
		""
		"&e&oДень 203.&r&o Четверо пали. Я больше не картограф: я сжёг столько пороха, что хватило бы на войну. Пятый страж — за краем мира, в &5цитадели, которая висит в пустоте&o. Туда ведёт око Эндера.&r"
		""
		"&e&oЯ иду один. Если не вернусь, пусть Мира не ищет меня. Пусть стро…&r"
		""
		"&oДальше страница обрывается.&r"]
	quest.5C0D0D4DEBC97B54.title: "Дневник, страница четвёртая"
	quest.5C9ECC41DD2F2B3C.quest_desc: ["&e&oДень 211.&r&o Я не смогу его победить. Но я понял, зачем нужен город. Печати держали не камни, а люди, которые жили рядом и помнили. Когда Вальдгард опустел, печати ослабли. Король лишь толкнул то, что уже падало.&r"
		""
		"&e&oЕсли кто-то читает это, значит, вы построили город и прошли весь путь. Значит, у этой земли снова есть люди, которые помнят. Стража может сложить оружие. А я могу отдохнуть.&r"
		""
		"&e&oМира, если ты здесь: я не пропал. Я просто ждал, пока появятся вы.&r"
		"&o— Элиас Ворн, магистр Ордена Картографов&r"
		"{@pagebreak}"
		"&oНа следующее утро серые плащи впервые за сто лет подняли над крепостью не зловещее знамя, а старый герб Вальдгарда. И отправили к вашей ратуше гонца.&r"
		""
		"&6Конец кампании «Пепел Вальдгарда».&r Спасибо, что дошли до конца."]
	quest.5C9ECC41DD2F2B3C.title: "Последняя запись"
	quest.5D46F3B1930C71CC.quest_desc: ["Когда рейд очень большой."]
	quest.5D46F3B1930C71CC.title: "Гатлинг"
	quest.5DDAACD331AFF2F9.quest_desc: ["Механический босс. Пушки Create пригодятся."]
	quest.5DDAACD331AFF2F9.title: "Предвестник"
	quest.5F45433066AEB4F5.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.5F45433066AEB4F5.title: "Последний удар"
	quest.614909EB879D3172.quest_desc: ["Наберите в колонии &eвосемь&r стражников. Одна башня город не удержит."]
	quest.614909EB879D3172.title: "Ополчение"
	quest.61A22BEBBA0FC478.quest_desc: ["&bBrewin' and Chewin'&r: пиво, медовуха, сыры. Для таверны в колонии самое то."]
	quest.61A22BEBBA0FC478.title: "Бочонок"
	quest.6244F9F1F56A292B.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.6244F9F1F56A292B.title: "Был в этом бою"
	quest.62B227894083694D.quest_desc: ["Сам рубит лес и сажает новый. Дерево больше не проблема."]
	quest.62B227894083694D.title: "Лесоруб"
	quest.64457C56B9D94320.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.64457C56B9D94320.title: "Последний удар"
	quest.6591E9B2E35931CF.quest_desc: ["Склад и курьеры: дальше ресурсы раздаются сами."]
	quest.6591E9B2E35931CF.title: "Склад"
	quest.66D93EF69FC6858E.quest_desc: ["В колонии живут &eпять&r поселенцев."
		""
		"&oПятеро — это уже не лагерь. Это деревня. Отец сказал бы, что пора отмечать её на картах.&r"
		"&d— Мира Ворн&r"]
	quest.66D93EF69FC6858E.title: "Нас уже пятеро"
	quest.67A698BAD8D03042.quest_desc: ["Классический финал. Только тут он не финал."]
	quest.67A698BAD8D03042.title: "Дракон"
	quest.68B9FC4C084E8B5D.quest_desc: ["&7Эпилог.&r Победите &eвсех&r Древних, включая необязательных."]
	quest.68B9FC4C084E8B5D.title: "Хранитель печатей"
	quest.68EAC7F8353ABF5D.quest_desc: ["Первый источник вращения."]
	quest.68EAC7F8353ABF5D.title: "Водяное колесо"
	quest.68F2A2A5B24F9821.quest_desc: ["У заклинателя нашлась третья тетрадь. Её не украли: Элиас отдал её сам."
		""
		"&e&oДень 77.&r&o Командир стражи — не враг. Он хранит то, что осталось от присяги. Он рассказал мне про печати: их было пять, и за каждой — страж. &6Пламя&o в пекле, &6Кузня душ&o в пекле, &6Машина&o под землёй, &6Бездна&o под морем. Пятый ждёт за краем мира.&r"
		""
		"&e&oДень 78.&r&o Пока Древние живы, стража будет защищать эту землю от всех, кто строит. Так им велел последний приказ. Если стражей не станет, их присяга закончится. Им нужен не враг, а город, который они смогут признать.&r"
		""
		"&e&oСтройте. Им нужен город, а не я.&r"
		"&o— Э. В.&r"]
	quest.68F2A2A5B24F9821.title: "Дневник, страница третья"
	quest.69278FABC2B772B0.quest_desc: ["Носит вещи между складом и хижинами."]
	quest.69278FABC2B772B0.title: "Курьер"
	quest.6A138F76E7BAE8AC.quest_desc: ["Поезда между колониями: удобно и красиво."]
	quest.6A138F76E7BAE8AC.title: "Железная дорога"
	quest.6CA6BFEEF41C2ED8.quest_desc: ["&bSophisticated Backpacks&r: ставь улучшения (подбор, сортировка, переплавка)."]
	quest.6CA6BFEEF41C2ED8.title: "Рюкзак"
	quest.6D4C66D9299954DE.quest_desc: ["Ещё один босс Cataclysm в Крае."]
	quest.6D4C66D9299954DE.title: "Страж Края"
	quest.6D944F176D3EE4A9.quest_desc: ["Спуститесь в подземный склеп, о котором писал Элиас."
		""
		"&7Подсказка: Better Dungeons: каменные комнаты с паутиной и спаунерами под землёй, часто рядом с шахтами."]
	quest.6D944F176D3EE4A9.title: "Склеп у дороги"
	quest.6E53B206230441D5.quest_desc: ["Серьёзная армия против серьёзных рейдов."]
	quest.6E53B206230441D5.title: "Казармы"
	quest.700A1AB8B52ECA88.quest_desc: ["В мире полно данжей (YUNG's, Dungeons and Taverns, When Dungeons Arise)."
		"&bLootr&r: у каждого игрока свой лут в сундуках, делить не придётся."]
	quest.700A1AB8B52ECA88.title: "Данжи"
	quest.704235305AB24600.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.704235305AB24600.title: "Последний удар"
	quest.70E206B0588184A8.quest_desc: ["Войну надо &aпринять&r, колонию отобрать нельзя, офлайн-рейдов нет."
		"Проигравший платит небольшую дань 48 часов. Разрушения откатываются после войны."
		"&7Так что можно иногда устроить дружескую осаду ради веселья."]
	quest.70E206B0588184A8.title: "Правила войны"
	quest.7152673C7D19920E.quest_desc: ["Нужны для латуни и многого другого."]
	quest.7152673C7D19920E.title: "Миксер и чаша"
	quest.720C6314F2E895A3.quest_desc: ["Объединитесь во фракцию: общая казна и союзники."
		"Создание стоит &a1000&r. Команды смотри в кодексе (&e/wnt&r)."]
	quest.720C6314F2E895A3.title: "Фракция"
	quest.73024F86A5FC4B20.quest_desc: ["Показывают скорость и нагрузку. Must have."]
	quest.73024F86A5FC4B20.title: "Очки инженера"
	quest.730530B9F089EAF8.quest_desc: ["&7Необязательно.&r Победите &eДревний остов&r."]
	quest.730530B9F089EAF8.title: "Древний остов"
	quest.736D1BFBEFEB5FC0.quest_desc: ["&bDroneworks&r: ядро дрона, пропеллеры и пульт. Есть FPV-камера."]
	quest.736D1BFBEFEB5FC0.title: "Дрон"
	quest.75113CA9793E2C94.quest_desc: ["Передают вращение."]
	quest.75113CA9793E2C94.title: "Валы и шестерни"
	quest.75A0E27F504D65AF.quest_desc: ["Сердце колонии. После неё появятся первые жители."
		"&7Стиль выбирается один раз, не торопись: нордический, средневековый, пустынный и т.д."]
	quest.75A0E27F504D65AF.title: "Ратуша"
	quest.75F53BEDF3D3E45A.quest_desc: ["Засчитается само, если именно вы нанесли последний удар."]
	quest.75F53BEDF3D3E45A.title: "Последний удар"
	quest.7780E0371A9C8A71.quest_desc: ["Огненный рыцарь &bCataclysm&r. Готовь огнестойкость."]
	quest.7780E0371A9C8A71.title: "Игнис"
	quest.795BA01048E4E6B7.quest_desc: ["Рейды варваров, пиратов и викингов придут, когда колония вырастет."
		"Башни и стражники обязательны. Ещё они немного повышают налоги."]
	quest.795BA01048E4E6B7.title: "Сторожевая башня"
	quest.79D1DE8B41EBD89F.quest_desc: ["Бросьте &5око Эндера&r и идите туда, куда оно летит."
		""
		"&oЯ не прошу вас найти отца. Я прошу вас дочитать его дневник.&r"
		"&d— Мира Ворн&r"]
	quest.79D1DE8B41EBD89F.title: "Око, которое смотрит"
	quest.7A4E2AB5077ED088.quest_desc: ["Колония стоит, дневник отца у вас. Дальше путь ведёт туда, где экспедиция искала «печати»."
		""
		"&aАкт I завершён.&r Откройте &eАкт II. Следы экспедиции&r."]
	quest.7A4E2AB5077ED088.title: "Дорога на север"
	quest.7E26B5334AECEC44.quest_desc: ["Последний удар нанёс союзник, а вы сражались рядом? Отметьте здесь."
		""
		"&7Это честная галочка: отмечайте, только если правда были в бою."]
	quest.7E26B5334AECEC44.title: "Был в этом бою"
	quest.7E8231D2AE25D321.quest_desc: ["&bCrafts & Additions&r: генератор и электромотор, провода между базами."]
	quest.7E8231D2AE25D321.title: "Электричество"
	quest.7F143BBC655E84DA.quest_desc: ["Глубины океана. Нужна вода и терпение."]
	quest.7F143BBC655E84DA.title: "Левиафан"
}
